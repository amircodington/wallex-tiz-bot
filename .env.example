MODE=paper                # paper | live
WALLEX_API_KEY=           # trade permission only, no withdrawal; server: leave empty, NO_LIVE=1
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
AI_API_KEY=               # GapGPT key for the AI judge and the panel chat (tiz.ai_http)
# AI_BASE_URL=https://api.gapgpt.app/v1  # default; any OpenAI-compatible gateway
AI_MODEL=claude-haiku-5-5  # must be a model the key allows (the default)
# END_TS=2026-10-26T23:50:00+03:30  # the default; no entries 3 h before, all sold 1 h before
# FEE_MAKER=0.0025        # paper only; live reads the real rate from /v1/account/fee
# FEE_TAKER=0.003
# ENTRY_EDGE=0.006
# ORDER_FRAC=0.25
# DAILY_STOP=0.05
